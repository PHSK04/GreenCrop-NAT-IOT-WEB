# PostgreSQL / Neon connection
DATABASE_URL=
DB_SSL_MODE=
DB_SSL_REJECT_UNAUTHORIZED=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# JWT secret for signing test tokens (change in production)
JWT_SECRET=dev_jwt_secret

# Google Sign-In (backend token verification)
# Use web client ID, or comma-separated IDs in GOOGLE_CLIENT_IDS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Facebook Login (backend token verification)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# LINE Login (backend token verification/exchange)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=

# Microsoft Login (backend token verification/exchange)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# Sign in with Apple (backend token verification audience)
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# Other settings
NODE_ENV=development
# Shared tenant key (used only when SHARED_SENSOR_TENANT=true)
DEFAULT_TENANT_ID=public
# false = bind sensor stream by logged-in account (tenant_id from token)
SHARED_SENSOR_TENANT=false
# true = backend records ESP32 telemetry from smartfarm/sensors even when the web app is closed
ACCEPT_LEGACY_SENSOR_TOPIC=true
# Enable the dev JWT mint endpoint only for local development (set to 'true' to enable)
ENABLE_DEV_TOKEN=false

# NAT AI real conversation mode (server-side only, never expose this in frontend env)
# Python controller runs first and returns structured intent/risk/actions.
NAT_AI_PYTHON_ENABLED=false
NAT_AI_PYTHON_BIN=python3
NAT_AI_PYTHON_SCRIPT=ai/controller/nat_ai_controller.py
NAT_AI_PYTHON_TIMEOUT_MS=2500
# OpenAI is the generative layer for natural/general agriculture-first conversation.
# Python still answers deterministic machine/sensor/control questions first.
# Cloud inference is disabled in code for this local-only deployment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=700
NAT_AI_OPENAI_GENERAL_ENABLED=false
NAT_AI_LLM_FIRST=true
NAT_AI_GENERATIVE_CHAT_REQUIRED=false
NAT_AI_OPENAI_CONTEXT_MAX_CHARS=8000
NAT_AI_OLLAMA_ENABLED=true
NAT_AI_OLLAMA_URL=http://127.0.0.1:11434
NAT_AI_OLLAMA_MODEL=qwen2.5:7b
NAT_AI_OLLAMA_TIMEOUT_MS=60000
NAT_AI_OLLAMA_TOOL_TIMEOUT_MS=15000
MQTT_COMMAND_ACK_TIMEOUT_MS=8000
MQTT_COMMAND_PUBLISH_RETRIES=1

# Local-only voice AI. No API key is sent to the browser.
NAT_AI_LOCAL_STT_ENABLED=false
NAT_AI_STT_ENGINE=faster-whisper
NAT_AI_STT_PYTHON_BIN=python3
NAT_AI_STT_SCRIPT=ai/stt/local_transcribe.py
NAT_AI_STT_MODEL=small
NAT_AI_STT_DEVICE=cpu
NAT_AI_STT_COMPUTE_TYPE=int8
NAT_AI_STT_TIMEOUT_MS=90000
NAT_AI_STT_MIN_CONFIDENCE=0.35
# Tests only; leave unset in real deployments.
# NAT_AI_STT_MOCK_TEXT=เฮ้ Green ทดสอบระบบ

# Local Thai voice model (no per-request API fee).
# Windows default: ../.venv-tts/Scripts/python.exe
# macOS/Linux default: ../.venv-tts/bin/python
NAT_AI_LOCAL_TTS_ENABLED=true
NAT_AI_TTS_PYTHON_BIN=
NAT_AI_TTS_MODEL=facebook/mms-tts-tha
NAT_AI_TTS_TIMEOUT_MS=120000
NAT_AI_TTS_MAX_TEXT_CHARS=1200
# `mms` uses the existing Thai voice. `xtts` is reserved for a reviewed local
# voice-cloning deployment; never expose the speaker WAV through the web server.
NAT_AI_TTS_ENGINE=mms
NAT_AI_XTTS_SPEAKER_WAV=
NAT_AI_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Allowed browser origins for CORS (comma-separated)
# Keep both local dev and GitHub Pages if you use both.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://phsk04.github.io
# localhost, 127.0.0.1, and [::1] are also allowed on any port for Flutter/Vite dev.
